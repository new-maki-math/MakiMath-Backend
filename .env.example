# 复制成 .env 后按需修改。
# npm start / npm run dev 会自动读取（node --env-file-if-exists=.env）

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=maki_math_dev

HOST=127.0.0.1
PORT=3000

# 反向代理信任级别，决定 req.ip / 审计日志里的客户端 IP 怎么取。
#   loopback  （默认）后端跑在本机 nginx 后面时用这个：只信任回环代理，
#              取 XFF 里由 nginx 追加的真实客户端 IP，客户端无法伪造
#   true      信任所有跳数（客户端可自带 XFF 伪造 IP，不要在生产使用）
#   false     不信任任何代理；本地直连、没有 nginx 时用这个
TRUST_PROXY=loopback

# Typst 可执行文件，生产上装到 PATH 后可以不管这项
TYPST_BIN=typst

LOG_LEVEL=info

# JWT 与 Payload 端到端加密密钥（严禁将生产密钥提交至公开代码仓库）
JWT_SECRET=your-secure-jwt-secret-here
# 必须为严格 32 字节字符
PAYLOAD_SECRET_KEY=your-32-byte-secret-aes-key-here
